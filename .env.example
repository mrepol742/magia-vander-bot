# discord
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-application-client-id
# set this to a specific server ID while testing for instant (non-global) command registration
DISCORD_GUILD_ID=

# Comma-separated channel IDs the bot is allowed to respond in.
# Leave blank to allow every channel.
ALLOWED_CHANNEL_IDS=
RESPOND_TO_QUESTION_MARKS=false

BOT_NAME='Magia Vander Bot'
SYNC_DISCORD_USERNAME=false

COMMAND_NAME=magia
TEXT_PREFIX=!
ENABLE_TEXT_PREFIX=true

# openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/auto
# shown to OpenRouter for routing/leaderboard purposes
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_SITE_NAME=GameGuideBot
