# mysql
DATABASE_URL="mysql://user:password@localhost:3306/magia_vander_bot"

# discord
DISCORD_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-application-client-id
# set this to a specific server ID while testing for instant (non-global) command registration
DISCORD_GUILD_ID=

# Comma-separated channel IDs the bot is allowed to respond in.
# Leave blank to allow every channel.
ALLOWED_CHANNEL_IDS=
RESPOND_TO_QUESTION_MARKS=false

# Comma-separated user IDs that are considered admins.
# Open Discord → User Settings (gear icon) → Advanced (under App Settings) → toggle Developer Mode ON.
# Right-click your own username/avatar anywhere and click Copy User ID
ADMIN_USER_IDS=

BOT_NAME="Magia Vander Bot"
SYNC_DISCORD_USERNAME=false

TEXT_PREFIX=!
ENABLE_TEXT_PREFIX=true

# openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_RAG_TOP_K=4
OPENROUTER_RAG_MIN_SIMILARITY=0.3
# shown to OpenRouter for routing/leaderboard purposes
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_SITE_NAME="Magia Vander Bot"
